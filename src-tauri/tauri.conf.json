{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VidPlayer",
  "version": "0.1.2",
  "identifier": "com.vidplayer.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "VidPlayer",
        "width": 900,
        "height": 600,
        "minWidth": 700,
        "minHeight": 400,
        "zoomHotkeysEnabled": true,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "lib/libmpv-2.dll",
      "lib/libmpv-wrapper.dll",
      "lib/ffmpeg.exe"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
